# Postgres. Neon is the actual database behind this URL.
# The app stores Granola login tokens and combined afterthought notes here.
DATABASE_URL=postgresql://user:pass@host/db?sslmode=require

# Optional. Shown in the UI so you can claim a neon.new database before it expires.
NEON_CLAIM_URL=https://neon.new/claim/...

# Optional. If unset, a token is generated and stored in the database on first boot.
PEBBLE_MCP_TOKEN=

# Optional override. Defaults to the current host (including Vercel URLs).
APP_URL=http://localhost:3000
